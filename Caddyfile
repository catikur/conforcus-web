# conforcus-web — Caddy ters proxy + otomatik HTTPS (Let's Encrypt)

# Ortak güvenlik başlıkları — her site bloğu bunu import eder.
(guvenlik) {
	header {
		# HTTPS'i tarayıcıya hatırlat (1 yıl)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# MIME tipi tahminini kapat
		X-Content-Type-Options "nosniff"
		# Çerçeveleme (clickjacking) koruması
		X-Frame-Options "SAMEORIGIN"
		# Referrer bilgisini sınırla
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kullanılmayan tarayıcı API'lerini kapat
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# Sunucu parmak izini gizle
		-Server
	}
}

# ── TEST ORTAMI ────────────────────────────────────────────────
# Bu iki adres yalnızca doğrulama içindir; arama motorlarına KAPALI
# (X-Robots-Tag). Üretim alan adına geçince bu kural onları etkilemez.
srv1709361.hstgr.cloud, web.conforcus.com {
	import guvenlik
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000
}

# ── ÜRETİM ─────────────────────────────────────────────────────
# DNS geçişinden SONRA (yalnızca Atilla'nın açık onayıyla) aşağıdaki
# bloğu açın; Caddy conforcus.com ve www için otomatik SSL alır.
# Not: burada X-Robots-Tag YOK — üretim indexlenmeye açıktır.
#
# conforcus.com, www.conforcus.com {
# 	import guvenlik
# 	reverse_proxy web:3000
# }
