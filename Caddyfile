# conforcus-web — Caddy ters proxy + otomatik HTTPS (Let's Encrypt)
#
# AŞAMA 1 — Doğrulama (DNS henüz conforcus.com'u VPS'e işaret etmiyor):
# srv hostname zaten VPS IP'sine (152.239.114.242) çözüldüğü için Caddy
# bunun için geçerli bir sertifika alabilir → https://srv1709361.hstgr.cloud
srv1709361.hstgr.cloud, web.conforcus.com {
	reverse_proxy web:3000
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}

# AŞAMA 2 — DNS geçişinden SONRA (yalnızca Atilla'nın açık onayıyla):
# yukarıdaki bloğu yorumlayıp aşağıdakini açın; Caddy www için SSL alır,
# apex ve web. kalıcı olarak www'ye yönlenir.
#
# www.conforcus.com {
# 	reverse_proxy web:3000
# }
# conforcus.com {
# 	redir https://www.conforcus.com{uri} permanent
# }
# web.conforcus.com {
# 	redir https://www.conforcus.com{uri} permanent
# }
