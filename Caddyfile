# conforcus-web — Caddy ters proxy + otomatik HTTPS (Let's Encrypt)
#
# DİKKAT: Bu dosya sunucudaki TÜM siteleri yönetir. Aşağıdaki
# trade./llm./florence. blokları BAŞKA projelere aittir — silinmemeli.

# Ortak güvenlik başlıkları — conforcus-web blokları bunu import eder.
(guvenlik) {
	header {
		# HTTPS'i tarayıcıya hatırlat (1 yıl)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# MIME tipi tahminini kapat
		X-Content-Type-Options "nosniff"
		# Çerçeveleme (clickjacking) koruması
		X-Frame-Options "SAMEORIGIN"
		# Referrer bilgisini sınırla
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kullanılmayan tarayıcı API'lerini kapat
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# Sunucu parmak izini gizle
		-Server
	}
}

# Erişim günlüğü — yalnız conforcus-web blokları import eder (başka projelerin bloklarına eklemeyin).
# Kişisel veriyi azaltmak için IP adresinin son bölümü maskelenir; çerez, yetkilendirme başlığı ve
# webhook gizli anahtarı kaydedilmez. Dosyalar caddy_data biriminde durur; her gün yeni dosyaya
# geçilir ve 89 günden eski dosyalar silinir, yani hiçbir kayıt 90 günden uzun saklanmaz
# (çerez politikasındaki süreyle aynı — birini değiştirirseniz diğerini de değiştirin).
# Özet için: scripts/log-report.py
(erisim_gunlugu) {
	log {
		output file /data/logs/conforcus-web-access.log {
			roll_size 20MiB
			roll_interval 24h
			roll_keep 100
			roll_keep_for 2136h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Revalidate-Secret delete
				request>headers>X-Forwarded-For delete
				request>uri query {
					delete secret
				}
				resp_headers>Set-Cookie delete
			}
		}
	}
}

# ── TEST / ÖNİZLEME ────────────────────────────────────────────
# Yalnızca doğrulama içindir; arama motorlarına KAPALI (X-Robots-Tag).
# Cutover'da www.conforcus.com üretim olur, burası web.→www yönlenir.
srv1709361.hstgr.cloud, web.conforcus.com {
	import guvenlik
	import erisim_gunlugu
	header X-Robots-Tag "noindex, nofollow"
	# İstek gövdesi sınırı: sitedeki en büyük meşru gövde analiz formu (en çok 32 KB).
	request_body {
		max_size 64KB
	}
	encode zstd gzip
	reverse_proxy web:3000
}

# ── ÜRETİM (cutover) ───────────────────────────────────────────
# DNS geçişinden SONRA (yalnızca Atilla'nın açık onayıyla) aşağıdakileri açın:
# www canonical, apex ve web. kalıcı olarak www'ye yönlenir.
# Not: üretim bloğunda X-Robots-Tag YOK — indexlenmeye açıktır.
#
# www.conforcus.com {
# 	import guvenlik
# 	import erisim_gunlugu
# 	request_body {
# 		max_size 64KB
# 	}
# 	encode zstd gzip
# 	reverse_proxy web:3000
# }
# conforcus.com {
# 	redir https://www.conforcus.com{uri} permanent
# }
# web.conforcus.com {
# 	redir https://www.conforcus.com{uri} permanent
# }

# ═══════════════════════════════════════════════════════════════
# AŞAĞISI BAŞKA PROJELERE AİT — conforcus-web dağıtımında korunur
# ═══════════════════════════════════════════════════════════════

# trade.conforcus.com — telegram-bybit-tradebot manual ingestion console.
# Reverse-proxied to the tradebot console container (joined to this stack network
# under alias tradebot-console). Console enforces CONSOLE_AUTH_TOKEN on top of TLS.
trade.conforcus.com {
	encode gzip
	request_body {
		max_size 40MB
	}
	reverse_proxy tradebot-console:8770
}

# llm.conforcus.com — LLM Explorer statik SPA (/opt/llm-explorer stack)
llm.conforcus.com {
	encode gzip
	reverse_proxy llm-explorer:80
}

# florence.conforcus.com — Florence Hakediş (revenue-share app, /root/florence-hakedis stack)
florence.conforcus.com {
	encode gzip
	reverse_proxy florence-app:8000
}

# racing.conforcus.com - isolated racing project, /opt/racing
racing.conforcus.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy racing-web:8080
}

# butler.conforcus.com — Agentic Inbox (M365 login gate). /opt/butler stack,
# alias "butler" on this compose network. Do not start a second Caddy.
butler.conforcus.com {
	encode gzip
	reverse_proxy butler:3000
}

# atlas.conforcus.com — paper research desk, /opt/atlas-gic stack,
# alias "atlas-gic" on this compose network. Do not start a second Caddy.
atlas.conforcus.com {
	encode gzip
	reverse_proxy atlas-gic:3000
}

# Append to /opt/conforcus-web/Caddyfile (back it up first, then `caddy validate` and `caddy reload`).
# symbiosis.conforcus.com — hybrid desk, /opt/symbiosis stack, alias "symbiosis-api" on this network.
symbiosis.conforcus.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy symbiosis-api:3000
}
